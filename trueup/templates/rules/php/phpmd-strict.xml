<!-- Managed by trueup. Edit trueup.toml, then run the trueup skill. -->
<!-- phpmd ruleset, strict mode: the size rules at the shared thresholds,
     plus the unused-code, design and clean-code rule sets. phpmd reports
     at the minimum value, so a minimum of 6 parameters allows 5, a
     reportLevel of 11 allows complexity 10 and a minimum of 61 allows 60 lines. -->
<ruleset name="trueup-strict">
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="11"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="61"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="6"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity"/>
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity"/>
    <rule ref="rulesets/unusedcode.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/cleancode.xml"/>
</ruleset>
